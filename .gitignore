# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS/Finder duplicates of source files ("Icons 2.tsx", "CountUp 10.ts",
# "page copy.tsx", "page copy 2.tsx").
#
# Deliberately limited to code extensions. A bare "* [0-9].*" also swallows
# legitimate content — "public/media/cohort 2.jpg", "content/chapter 2.md" —
# which then silently fails to deploy. Keep this list extension-scoped.
# (.gitignore has no brace expansion, hence one line per extension.)
* [0-9].ts
* [0-9].tsx
* [0-9].js
* [0-9].jsx
* [0-9].css
* [0-9][0-9].ts
* [0-9][0-9].tsx
* [0-9][0-9].js
* [0-9][0-9].jsx
* [0-9][0-9].css
* copy.ts
* copy.tsx
* copy.js
* copy.jsx
* copy.css
* copy [0-9].ts
* copy [0-9].tsx
* copy [0-9].js
* copy [0-9].jsx
* copy [0-9].css
